{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/secrets/**)",
      "Read(**/config/credentials.json)",
      "Read(**/build)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc)",
      "Edit(**/secrets/**)",
      "Edit(**/config/credentials.json)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.envrc)",
      "Write(**/secrets/**)",
      "Write(**/config/credentials.json)",
      "MultiEdit(**/.env)",
      "MultiEdit(**/.env.*)",
      "MultiEdit(**/.envrc)",
      "MultiEdit(**/secrets/**)",
      "MultiEdit(**/config/credentials.json)"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-sensitive.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "language": "Italian",
  "effortLevel": "medium",
  "tui": "default",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "dark-ansi",
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false
}
